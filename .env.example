# Copy to .env.local for local dev (.env.local is gitignored). Never commit real secrets.
# On Vercel set the same names in Project Settings -> Environment Variables.

# Signs/validates the bbp_auth cookie for page gating.
# MUST equal the backend's AUTH_SECRET exactly. Generate: openssl rand -hex 32
AUTH_SECRET=change-me-to-the-same-secret-as-the-backend

# Backend origin (no trailing slash). Read at BUILD time by next.config.mjs rewrites
# (/api/* is proxied there) and at runtime by the ZIP download redirect.
# Local: http://localhost:8080   Vercel: https://<your-backend>.vercel.app
# Changing it on Vercel requires a redeploy; locally restart `pnpm dev`.
BACKEND_URL=http://localhost:8080
